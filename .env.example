PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wagering_db
DB_POOL_MAX=10
DB_LOCK_TIMEOUT_MS=2000
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
SQS_REQUEST_TIMEOUT_MS=3000
SQS_QUEUE_WAGER_TRANSACTIONS=wager-transactions.fifo
SQS_QUEUE_WAGER_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_QUEUE_WAGER_EVENTS=wager-events.fifo
SQS_WAIT_SECONDS=10
SQS_MAX_MESSAGES=10
SQS_CONSUMER_CONCURRENCY=5
SQS_RETRY_BASE_SECONDS=2
SQS_RETRY_MAX_SECONDS=60
SQS_MAX_RECEIVE_COUNT=5
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
PENDING_REFERENCE_BASE_DELAY_MS=2000
PENDING_REFERENCE_MAX_DELAY_MS=60000
PENDING_REFERENCE_MAX_ATTEMPTS=8
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=10
ENABLE_HTTP=true
ENABLE_SQS_CONSUMER=true
ENABLE_OUTBOX_PUBLISHER=true
ENABLE_PENDING_WORKER=true
