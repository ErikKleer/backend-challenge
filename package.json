{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "typecheck": "bunx --bun tsc --noEmit",
    "test": "bun test test/unit test/integration test/concurrency --pass-with-no-tests",
    "test:unit": "bun test test/unit --pass-with-no-tests",
    "test:integration": "bun test test/integration --timeout 60000 --pass-with-no-tests",
    "test:concurrency": "bun test test/concurrency --timeout 120000 --pass-with-no-tests",
    "migration:up": "bun run scripts/migrate.ts up",
    "migration:down": "bun run scripts/migrate.ts down",
    "migration:create": "mikro-orm migration:create",
    "infra:up": "docker compose up -d --wait postgres localstack && docker compose up provision",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:provision": "bun run scripts/provision-queues.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.750.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/nestjs": "^6.0.2",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "decimal.js": "^10.4.3",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
